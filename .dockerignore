# Контекст сборки уходит демону целиком, поэтому всё, чем образ не пользуется, — груз.
.git/
.github/

# Окружения и кеши. Образ строит своё из pyproject.toml и uv.lock.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Рабочее состояние и ключи машины разработчика в образ попадать не должны: ключи
# создаются в томе контейнера при первом запуске.
var/
.env

# Тесты, скрипты, отчёты и документы из запроса недостижимы.
tests/
scripts/
reports/
docs/

.DS_Store
