# Окружение uv строит из pyproject.toml и uv.lock; само дерево привязано к машине и
# весит несколько сотен мегабайт.
.venv/

# Результаты сборки и кеши. Ничто из этого ни для чего не является входными данными.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Данные кейса. Производство закрытое, и публиковать выданные материалы мы не вправе;
# к тому же снимки деталей весят больше, чем имеет смысл хранить в git.
data/

# Обученные веса. Воспроизводятся из кода и данных, а весят сотни мегабайт.
models/
*.pt
*.pth
*.onnx
*.ckpt

# Секреты и адреса серверов. Их читают запуск и деплой, публиковать их нельзя.
.env
.env.*

# Рабочие заметки, а не результат работы. Всё, написанное, чтобы объяснить работу
# самим себе, в репозиторий не попадает.
docs/notes/

.vscode/
.idea/
.DS_Store
