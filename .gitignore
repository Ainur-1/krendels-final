# Окружение uv строит из pyproject.toml и uv.lock; само дерево привязано к машине и
# весит несколько сотен мегабайт.
.venv/

# Результаты сборки и кеши. Ничто из этого ни для чего не является входными данными.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Рабочее состояние сервиса: журнал событий и ключи. Журнал воспроизводится из
# сценариев в data/scenarios, а ключи создаются на каждой машине заново и не должны
# покидать её никогда — секретный ключ в репозитории перестаёт быть секретным.
var/

# Отчёты нагрузочного прогона зависят от машины; воспроизводятся командой из README.
reports/load/

# Секреты и адреса серверов. Их читают запуск и деплой, публиковать их нельзя.
.env
.env.*

# Рабочие заметки, а не результат работы. Всё, написанное, чтобы объяснить работу
# самим себе, в репозиторий не попадает.
docs/notes/

.vscode/
.idea/
.DS_Store
